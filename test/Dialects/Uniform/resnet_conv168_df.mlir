// RUN: scheduler %s | scheduler | FileCheck %s

#map = affine_map<(d0, d1, d2, d3, d4, d5, d6) -> (d6 * 2048 + d5 * 512 + d4 * 512 + d3 * 512 + d2 * 128 + d1 * 2 + d0)>
#map1 = affine_map<(d0, d1, d2, d3, d4, d5, d6) -> (d0, d1, d2, d3, d4, d5, d6)>
#map2 = affine_map<(d0) -> (d0 mod 16)>
