#set3 = affine_set<(d0, d1, d2, d3, d4) : (d0 >= 0, -d0 + 63 >= 0, d1 == 0, d2 == 0, d3 == 0, d4 == 0)>
#set4 = affine_set<(d0) : (d0 - 256 >= 0, -d0 + 255 >= 0)>
#set5 = affine_set<(d0, d1, d2, d3, d4) : (d0 >= 0, -d0 + 3 >= 0, d1 == 0, d2 == 0, d3 == 0, d4 == 0)>
#set6 = affine_set<(d0, d1, d2, d3, d4, d5, d6) : (d0 >= 0, -d0 + 7 >= 0, d1 >= 0, -d1 + 1 >= 0, d2 >= 0, -d2 + 7 >= 0, d3 == 0, d4 == 0, d5 == 0, d6 == 0)>
